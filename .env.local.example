# Copy to .env.local for local development. Never commit real secrets.
#
# These two are NOT secret — Supabase's anon/publishable key is designed to
# be public (Row-Level Security is the real boundary, see docs/security.md)
# — so src/lib/env.ts falls back to the deployed project's values if these
# are unset. Set them explicitly to point at a different Supabase project
# (e.g. after rotating the key, or for a separate staging environment).
NEXT_PUBLIC_SUPABASE_URL=https://mggcfgfovipyomziwkef.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
